# Reproducible Android build environment for TrashSoccer 2026 refresh.
#
# Pins nixpkgs to the channel revision currently selected on this machine so the
# whole Android SDK + toolchain is derivable from Nix alone.
#
# Usage:
#   nix-shell
#     OR
#   nix-shell --run "./gradlew :android:assembleDebug -x lint"
{
  # Config accepts the Android SDK licenses declaratively.
  pkgs ? import <nixpkgs> {
    config = {
      allowUnfree = true;
      android_sdk.accept_license = true;
    };
  },
  jdk ? pkgs.jdk17,
}:

let
  androidEnv = pkgs.androidenv;

  androidComposition = androidEnv.composeAndroidPackages {
    # Android 16 == API 36; also install 35 as fallback.
    platformVersions = [ "36" "35" ];
    buildToolsVersions = [ "36.0.0" "35.0.0" ];
    platformToolsVersion = "latest";
    cmdLineToolsVersion = "latest";
    includeSystemImages = false;
    includeEmulator = false;
    includeNDK = false;
    includeCmake = false;
  };

  androidSdk = androidComposition.androidsdk;
  platformTools = androidComposition.platform-tools;
in
pkgs.mkShell {
  name = "trashsoccer-android";

  packages = [ androidSdk platformTools pkgs.gradle jdk ];

  LANG = "C.UTF-8";
  LC_ALL = "C.UTF-8";
  JAVA_HOME = jdk.home;

  ANDROID_HOME = "${androidSdk}/libexec/android-sdk";

  shellHook = ''
    # AGP normally fetches aapt2 from Maven; tell it to use the one bundled in the
    # nix-provided SDK so the build stays fully offline/reproducible.
    export GRADLE_OPTS="-Dorg.gradle.project.android.aapt2FromMavenOverride=$(echo "$ANDROID_HOME/build-tools/"*/aapt2 | awk '{print $1}')"

    # Point AGP at the nix SDK instead of a manually installed one.
    cat > local.properties <<EOF
    # This file is generated by shell.nix - do not edit by hand.
    sdk.dir=$ANDROID_HOME
    EOF
  '';
}